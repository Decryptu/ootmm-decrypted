+static void Multi_SendNextQueued(void)
+{
+    MultiQueue* q;
+    MultiPacketHeader* pkt;
+
+    q = &gSharedCustomSave.multiQueue;
+    if (!q->count || gSharedCustomSave.multi.sendBufferSize)
+        return;
+
+    memcpy(&gSharedCustomSave.multi.sendBuffer, q->buffer[0], sizeof(q->buffer[0]));
+    gSharedCustomSave.multi.sendBufferSize = q->size[0];
+    gSharedCustomSave.multi.sendBufferToken = q->token[0];
+    q->count--;
+    for (int i = 0; i < q->count; ++i)
+    {
+        memcpy(q->buffer[i], q->buffer[i + 1], sizeof(q->buffer[0]));
+        q->size[i] = q->size[i + 1];
+        q->token[i] = q->token[i + 1];
+    }
+
+    pkt = (MultiPacketHeader*)&gSharedCustomSave.multi.sendBuffer;
+    Multi_SendPacket(pkt, gSharedCustomSave.multi.sendBufferSize);
+    gMulti.ttlResend = TTL_RESEND;
+}
