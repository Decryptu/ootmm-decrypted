diff --git a/packages/generator/src/common/switch.c b/packages/generator/src/common/switch.c
index 1374d8e..3fb1be4 100644
--- a/packages/generator/src/common/switch.c
+++ b/packages/generator/src/common/switch.c
@@ -7,10 +7,12 @@ typedef void (*EntryPoint)(void)  __attribute__ ((noreturn));
 
 #if defined(GAME_OOT)
 # define FOREIGN_OFF    0x80000
+# define FOREIGN_THREAD_TAIL 0x80097e10
 # define FOREIGN_CART   (0x10001000 + MM_BASE)
 # define FOREIGN_SIZE   0x19500
 #else
 # define FOREIGN_OFF    0x400
+# define FOREIGN_THREAD_TAIL 0x80006330
 # define FOREIGN_CART   0x10001000
 # define FOREIGN_SIZE   0x6430
 #endif
@@ -20,17 +22,18 @@ static void waitSubsystems(void)
 {
     u32 tmp;
 
-    for (;;)
+    /* Virtual Console may never finish a task once interrupts are off: stop the RSP instead of waiting forever */
+    for (u32 i = 0; i < 0x100000; ++i)
     {
         tmp = IO_READ(SP_STATUS_REG);
-        if ((tmp & 2) && (tmp & 1) && !(tmp & (SP_STATUS_DMA_BUSY | SP_STATUS_DMA_FULL)))
+        if ((tmp & 1) && !(tmp & (SP_STATUS_DMA_BUSY | SP_STATUS_DMA_FULL)))
             break;
     }
     IO_WRITE(SP_STATUS_REG, SP_SET_HALT | SP_CLR_BROKE | SP_CLR_INTR | SP_CLR_SSTEP | SP_CLR_INTR_BREAK | SP_CLR_SIG0 | SP_CLR_SIG1 | SP_CLR_SIG2 | SP_CLR_SIG3 | SP_CLR_SIG4 | SP_CLR_SIG5 | SP_CLR_SIG6 | SP_CLR_SIG7);
     IO_WRITE(SP_SEMAPHORE_REG, 0);
     IO_WRITE(SP_PC_REG, 0);
 
-    for (;;)
+    for (u32 i = 0; i < 0x100000; ++i)
     {
         tmp = IO_READ(DPC_STATUS_REG);
         if (!(tmp & 0x170))
@@ -63,11 +66,95 @@ static void waitSubsystems(void)
     }
     IO_WRITE(SI_STATUS_REG, 0);
 
-    /* Disable VI */
-    IO_WRITE(VI_CONTROL_REG, 0);
+    /* Keep VI running: Virtual Console stops sending retrace interrupts when it is turned off, and the next game waits for them forever */
     IO_WRITE(VI_CURRENT_REG, 0);
 }
 
+/*
+ * Wii Virtual Console reads the addresses of libultra's scheduler variables from OoT's exception
+ * handler once, then uses them for every exception. Both games keep these variables in one block
+ * (vc_libultra.S), which is reset here for the next game, with its own thread queue tail.
+ */
+static void resetSchedulerBlock(void)
+{
+    volatile u32* block = (volatile u32*)0x80000200;
+
+    block[0] = FOREIGN_THREAD_TAIL; /* __osRunQueue */
+    block[1] = FOREIGN_THREAD_TAIL; /* __osActiveQueue */
+    block[2] = 0;                   /* __osRunningThread */
+    block[3] = 0;                   /* __osFaultedThread */
+    block[4] = 0x003fff01;          /* __OSGlobalIntMask */
+#pragma GCC unroll 32
+    for (int i = 0; i < 32; ++i)
+        block[8 + i] = 0;           /* __osEventStateTab */
+}
+
+/*
+ * Virtual Console also replaces five libultra thread functions with calls into the emulator, but only in
+ * OoT's RAM, the first time. The next game's copies are loaded unchanged from the ROM, so copy the
+ * replacement words to them. Other emulators and the console leave send_mesg as MIPS code.
+ */
+typedef struct
+{
+    u32 oot;
+    u32 mm;
+    u32 count;
+}
+VcPatch;
+
+static const VcPatch kVcPatches[] = {
+    { 0x80002964, 0x8008905c, 3 }, /* send_mesg */
+    { 0x80002a58, 0x80089150, 1 }, /* __osEnqueueAndYield */
+    { 0x80002b4c, 0x80089244, 3 }, /* __osEnqueueThread */
+    { 0x80002b94, 0x8008928c, 3 }, /* __osPopThread */
+    { 0x80002ba4, 0x800892a4, 1 }, /* __osDispatchThread */
+};
+
+static void copyVcPatches(void)
+{
+    const VcPatch* p;
+    const volatile u32* src;
+    volatile u32* dst;
+
+    for (u32 i = 0; i < ARRAY_COUNT(kVcPatches); ++i)
+    {
+        p = &kVcPatches[i];
+#if defined(GAME_OOT)
+        src = (const volatile u32*)(p->oot | 0xa0000000);
+        dst = (volatile u32*)(p->mm | 0xa0000000);
+#else
+        src = (const volatile u32*)(p->mm | 0xa0000000);
+        dst = (volatile u32*)(p->oot | 0xa0000000);
+#endif
+        /* VC library call opcode (0x7c000000 | function index) */
+        if ((src[0] & 0xffffff00) != 0x7c000000)
+            return;
+        for (u32 j = 0; j < p->count; ++j)
+            dst[j] = src[j];
+    }
+}
+
+void osInvalICache(void* addr, s32 size);
+
+/*
+ * Virtual Console runs RSP tasks and reports their end through interrupts. A task still running when the
+ * switch turns interrupts off never ends, and the next game then waits forever for the RSP. Let the running
+ * graphics and audio tasks finish first, with interrupts still on.
+ */
+static void drainRsp(void)
+{
+    u32 idle = 0;
+
+    for (u32 i = 0; i < 0x400000 && idle < 0x400; ++i)
+    {
+        u32 sp = IO_READ(SP_STATUS_REG);
+        u32 dp = IO_READ(DPC_STATUS_REG);
+        if ((sp & 1) && !(sp & (SP_STATUS_DMA_BUSY | SP_STATUS_DMA_FULL)) && !(dp & 0x170))
+            ++idle;
+        else
+            idle = 0;
+    }
+}
 NORETURN void comboGameSwitch2(void);
 NORETURN void comboGameSwitch4(u32);
 
@@ -78,6 +165,7 @@ NORETURN void comboGameSwitch(PlayState* play, u32 entrance)
 
     if (play)
         Save_DoSave(play, SF_OWL);
+    drainRsp();
     System_DisableInterrupts();
     waitSubsystems();
     comboGameSwitch2();
@@ -92,6 +180,17 @@ NORETURN void comboGameSwitch3(void)
     System_InvalICache((void*)FOREIGN_DRAM, FOREIGN_SIZE);
     IO_WRITE(PI_STATUS_REG, PI_STATUS_RESET | PI_STATUS_CLR_INTR);
 
+    /*
+     * The next game decompresses its code over code this game ran. Virtual Console replaces
+     * osInvalICache with a call that drops its translated code for the range, but only on one
+     * side of its function tree's root, so invalidate in small pieces. This code runs from KSEG1,
+     * which that call leaves alone.
+     */
+    for (u32 addr = 0x80000000; addr < 0x80800000; addr += 0x2000)
+        osInvalICache((void*)addr, 0x2000);
+
     Context_Export();
+    copyVcPatches();
+    resetSchedulerBlock();
     comboGameSwitch4(FOREIGN_DRAM);
 }
