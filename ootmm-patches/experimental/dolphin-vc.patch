@@ -115,6 +115,13 @@ void DmaManagerRunRequest(const DmaRequest* dma)
 
     if (e.pend == 0)
     {
+        /*
+         * A zero-length PI transfer programs a length of 0xffffffff. Wii Virtual Console then
+         * copies the ROM over the rest of RDRAM, including the payload.
+         */
+        if (dma->size == 0)
+            return;
+
         /* File is not compressed - load and allow partial loading */
         offset = dma->vromAddr - e.vstart;
         DMARomToRam((e.pstart + offset) | PI_DOM1_ADDR2, dma->dramAddr, dma->size);
